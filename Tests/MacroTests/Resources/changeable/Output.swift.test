struct A {
let a: String
let b: Int
var hasInt: Bool {
b != nil
}

    public func withChanges(
      a: String? = nil,
      b: Int? = nil
    ) -> Self {
      Self(
        a: a ?? self.a,
        b: b ?? self.b
      )
    }
}
struct B: Applicable {
let a: String
let b: Int
var hasInt: Bool {
b != nil
}

    public func withChanges(
      a: String? = nil,
      b: Int? = nil
    ) -> Self {
      Self(
        a: a ?? self.a,
        b: b ?? self.b
      )
    }

    public func apply(action: SetValue<Self, some Any>) -> Self {
      let value = action.value

      return switch action.path {
      case \Self.a:
          withChanges(a: (value as! String))
      case \Self.b:
          withChanges(b: (value as! Int))
      default:
        self
      }
    }
}
